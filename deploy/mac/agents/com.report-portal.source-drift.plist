<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  report-portal 源码漂移巡检（日更），判决写进 fleet-ops SessionStart 读的状态文件。

  刻意不指向开发工作树：kg-hub 的同类 plist 把路径渲染成
  /Users/mac/workspace_claudeCode/... ，那正是准则 20 点名的形态（13 个 launchd
  直跑工作区 → 改完即生效 = 没有发布这一步，且所有会话被迫在同一棵树上改生产）。
  这里跑 __HOME__/.local/share/report-portal/repo 这个私有 clone，只从 origin
  快进；共享工作树里谁有在途改动，都不会悄悄改变这个探针的行为。

  跑之前先把工作树切到 origin/main。
  **fetch 不动工作树** —— 装上那天检出的是哪个 commit，之后就一直跑哪个。
  2026-09-21 实测：克隆停在 af6439c，而主干早已走远，于是这个探针天天写出
  新鲜的时间戳、用的却是装机那天的判断逻辑。这正是它自己要治的那种病
  （新鲜的时间戳盖着陈旧的结论），只不过病在检查器自己身上。

  两种失败刻意分开：
    fetch 失败    → 照跑。本地 origin/main 还在，陈旧只造成单向的错（见
                    fleetops_drift.trunk_verdict 的注释），而这条链路有据可查
                    地会抖，天天亮的橙灯等于没有灯。
    checkout 失败 → exit 2。那不是抖，是克隆真的坏了（脏了 / refs 没了），
                    此时跑出来的任何结论都不知道是哪一版算的。

  安装：deploy/mac/install-drift-probe.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.report-portal.source-drift</string>

    <!--
      退出码要按「这个作业跑成了没有」来给，不是按「有没有漂移」。
      检查器的 CLI 语义是 0=一致 1=有漂移 2=查不了，给人和脚本用正好；但直接把
      它交给 launchd 的话，一旦真查出漂移，装置健康检查就会把它报成
      `last exit code: 1` 的故障作业——探针明明干得好好的。实测过：同一个漂移
      同时冒出一条正确的🔴和一条误导的「作业出错」，而后者会教人忽略这条线。
      所以：0/1 都算跑成（判决在状态文件里），只有 2（拿不到指纹、判不了）才
      让作业显示为失败——那时候它确实坏了。
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>cd "$HOME/.local/share/report-portal/repo" || exit 2; git fetch origin --quiet; git checkout -q --detach origin/main || exit 2; /usr/bin/python3 deploy/check_source_drift.py --status-file "$HOME/.cache/report-portal/source-drift.status"; rc=$?; [ $rc -le 1 ] &amp;&amp; exit 0; exit $rc</string>
    </array>

    <!-- 巡检每天跑一次；hook 那边 36 小时算停更，留了一次失败的余量。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <!-- 开机/登录后也补一次，免得关机一晚回来就是「已停更」。 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/report-portal-source-drift.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/report-portal-source-drift.err.log</string>
</dict>
</plist>
